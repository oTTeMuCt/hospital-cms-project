# =============================================================================
# Hospital CMS - Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option 1: Full DATABASE_URL (preferred)
DATABASE_URL=postgres://hospital:hospital_pass@db:5432/hospital_cms

# Option 2: Individual settings (used if DATABASE_URL is not set)
POSTGRES_DB=hospital_cms
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (required for cache, throttling, lockout, celery)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
# Generate a production SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Minimum 50 characters, cryptographically random.
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
FRONTEND_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# CORS (production: set CORS_ALLOW_ALL_ORIGINS=False and specify origins)
# ---------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# HTTPS / HSTS (enable in production with valid SSL certificate)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# ---------------------------------------------------------------------------
# JWT Token Lifetimes
# ---------------------------------------------------------------------------
JWT_ACCESS_LIFETIME=30
JWT_REFRESH_LIFETIME=1

# ---------------------------------------------------------------------------
# Email (for password reset)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@hospitalcms.com

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram.
# Generate BOT_API_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
BOT_API_KEY=

# ---------------------------------------------------------------------------
# Account Lockout
# ---------------------------------------------------------------------------
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
BOT_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin