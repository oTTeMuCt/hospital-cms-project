# Database
POSTGRES_DB=hospital_cms
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Django
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
FRONTEND_URL=http://localhost:3000

# CORS (production: set to False and specify origins)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTPS (enable in production)
SECURE_SSL_REDIRECT=False
HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Email (for password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@hospitalcms.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=
BOT_API_KEY=HCMS-Bot-2024-Secret

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
BOT_PORT=8080

# Account Lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15