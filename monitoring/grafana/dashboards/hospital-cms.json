{
  "title": "Hospital CMS - Production Monitoring",
  "uid": "hospital-cms-production",
  "version": 1,
  "timezone": "browser",
  "schemaVersion": 36,
  "panels": [
    {
      "title": "Authentication - Login Rate",
      "type": "graph",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(django_http_requests_total{method='POST', endpoint='/api/auth/token/'}[5m])",
          "legendFormat": "Login attempts"
        }
      ],
      "description": "Rate of login attempts per 5 minutes"
    },
    {
      "title": "Authentication - Login Failures",
      "type": "graph",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(django_http_responses_total{status=~'4..', endpoint='/api/auth/token/'}[5m])",
          "legendFormat": "Failed logins"
        }
      ],
      "description": "Rate of failed login attempts (4xx responses)"
    },
    {
      "title": "Account Lockouts",
      "type": "stat",
      "gridPos": {"x": 0, "y": 8, "w": 4, "h": 6},
      "targets": [
        {
          "expr": "increase(django_http_responses_total{status='429', endpoint='/api/auth/token/'}[24h])",
          "legendFormat": "Lockouts (24h)"
        }
      ],
      "description": "Number of account lockouts in the last 24 hours"
    },
    {
      "title": "API Request Rate by Status",
      "type": "graph",
      "gridPos": {"x": 4, "y": 8, "w": 20, "h": 6},
      "targets": [
        {
          "expr": "rate(django_http_responses_total{status=~'2..'}[5m])",
          "legendFormat": "2xx Success"
        },
        {
          "expr": "rate(django_http_responses_total{status=~'4..'}[5m])",
          "legendFormat": "4xx Client Error"
        },
        {
          "expr": "rate(django_http_responses_total{status=~'5..'}[5m])",
          "legendFormat": "5xx Server Error"
        }
      ],
      "description": "API response rate by HTTP status code"
    },
    {
      "title": "Response Time (p50/p95/p99)",
      "type": "graph",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(django_http_requests_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(django_http_requests_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(django_http_requests_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "description": "API response time percentiles"
    },
    {
      "title": "Active Requests",
      "type": "graph",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "django_http_requests_active_total",
          "legendFormat": "Active requests"
        }
      ],
      "description": "Currently active HTTP requests"
    },
    {
      "title": "Database Health",
      "type": "stat",
      "gridPos": {"x": 0, "y": 22, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "django_db_connections_total",
          "legendFormat": "DB connections"
        }
      ],
      "description": "Total database connections"
    },
    {
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": {"x": 4, "y": 22, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "rate(django_cache_hits_total[5m]) / (rate(django_cache_hits_total[5m]) + rate(django_cache_misses_total[5m])) * 100",
          "legendFormat": "Cache hit %"
        }
      ],
      "description": "Cache hit ratio percentage"
    },
    {
      "title": "System Errors (24h)",
      "type": "stat",
      "gridPos": {"x": 8, "y": 22, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "increase(django_http_responses_total{status=~'5..'}[24h])",
          "legendFormat": "5xx errors (24h)"
        }
      ],
      "description": "Total 5xx errors in the last 24 hours"
    },
    {
      "title": "Telegram Bot Activity",
      "type": "graph",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 4},
      "targets": [
        {
          "expr": "rate(django_http_requests_total{endpoint=~'/api/bot/.*'}[5m])",
          "legendFormat": "Bot API calls"
        }
      ],
      "description": "Rate of Telegram bot API calls"
    }
  ],
  "tags": ["hospital-cms", "production"],
  "time": {"from": "now-6h", "to": "now"}
}